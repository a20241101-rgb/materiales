anados + 1 # a mi variable ganados le voy agregando 1\n","    elif row['FTR'] == 'A': #Evaluamos si el resultado indica una victoria visitante ('A'), lo que representa una derrota para el local\n","        perdidos = perdidos + 1 # voy agregarle +1 a mi variable perdidos\n","    else: #Si no es victoria ni derrota, por defecto el resultado corresponde a un empate\n","        empatados = empatados + 1 # Incrementamos en 1 el contador de empates\n","\n","print(\"Ganados:\", ganados)# Imprimimos en la consola el total acumulado de partidos ganados\n","print(\"Perdidos:\", perdidos) # Imprimimos en la consola el total acumulado de partidos perdidos\n","print(\"Empatados:\", empatados) # Imprimimos en la consola el total acumulado de partidos empatados"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"H26Q5MzCYCko","executionInfo":{"status":"ok","timestamp":1794285604647,"user_tz":300,"elapsed":30,"user":{"displayName":"MATISSE STEPHANIA HUILLCA HERRERA","userId":"07426155358166726518"}},"outputId":"1ad781a0-4194-4a29-d5ac-03c3820ef8f2"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["Ganados: 8\n","Perdidos: 5\n","Empatados: 6\n"]}]},{"cell_type":"code","source":["labels = ['Ganados', 'Perdidos', 'Empatados'] # Definimos una lista con las etiquetas de texto que identificarán a cada porción del gráfico circular\n","# Creamos una lista con los valores acumulados (partidos ganados, perdidos y empatados) que determinan el tamaño de cada porción\n","sizes = [ganados, perdidos, empatados]\n","colors = [\"#4CAF50\", \"#FFC107\", \"#F44336\"] # Definimos una lista con los códigos de colores para personalizar cada sección del gráfico\n","plt.figure(figsize=(5, 5))\n","plt.title('Resultados de partido como Local del Valencia') # Asignamos un título descriptivo al gráfico circular para indicar qué datos estamos visualizando\n","plt.pie(sizes, labels=labels, colors=colors, autopct='%1.1f%%', shadow=True, startangle=100)# Generamos el